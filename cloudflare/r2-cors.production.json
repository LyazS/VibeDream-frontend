{
  "rules": [
    {
      "id": "pages-model-assets",
      "allowed": {
        "origins": ["https://lightcut-editor.pages.dev", "https://preview.lightcut-editor.pages.dev", "http://localhost:5173", "http://localhost:8788"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "Content-Type", "Origin"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
